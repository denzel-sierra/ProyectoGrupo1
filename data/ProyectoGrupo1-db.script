CREATE MEMORY TABLE PUBLIC.AUTOPARTES(ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,ANIO INTEGER NOT NULL,CONDICION VARCHAR(30) NOT NULL,COSTO_PRORRATEADO NUMERIC(10,2),CREADO_EN TIMESTAMP,DESCRIPCION VARCHAR(200) NOT NULL,ESTADO VARCHAR(20) NOT NULL,MARCA VARCHAR(50) NOT NULL,MODELO VARCHAR(50) NOT NULL,SKU VARCHAR(30) NOT NULL,CATEGORIA_ID INTEGER NOT NULL,UBICACION_ID INTEGER NOT NULL,CHECK((PUBLIC.AUTOPARTES.CONDICION) IN (('Nueva'),('Usada'),('Recuperada'))),CHECK((PUBLIC.AUTOPARTES.ESTADO) IN (('Disponible'),('Reservada'),('Vendida'),('Da\u00f1ada'))),CONSTRAINT UKCW9XXP8R690E1Y2G6YBT0I53K UNIQUE(SKU),CONSTRAINT FK6FER7HHW2791BKVSWWGF9LS1O FOREIGN KEY(CATEGORIA_ID) REFERENCES PUBLIC.CATEGORIAS(ID),CONSTRAINT FKD7PHX5NV8QKSLAJR8RHCNXQDT FOREIGN KEY(UBICACION_ID) REFERENCES PUBLIC.UBICACIONES(ID))
