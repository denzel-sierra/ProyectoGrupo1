CREATE MEMORY TABLE PUBLIC.ROLES(ID VARCHAR(20) NOT NULL PRIMARY KEY,ACCESOANALITICA BOOLEAN DEFAULT FALSE NOT NULL,ACCESOBITACORA BOOLEAN DEFAULT FALSE NOT NULL,ACCESOCLIENTES BOOLEAN DEFAULT FALSE NOT NULL,ACCESOINVENTARIO BOOLEAN DEFAULT FALSE NOT NULL,ACCESOLOTES BOOLEAN DEFAULT FALSE NOT NULL,ACCESOPRECIOS BOOLEAN DEFAULT FALSE NOT NULL,ACCESOSEGURIDAD BOOLEAN DEFAULT FALSE NOT NULL,ACCESOVENTAS BOOLEAN DEFAULT FALSE NOT NULL,DESCRIPCION VARCHAR(200),NOMBRE VARCHAR(50),CONSTRAINT UKLDV0V52E0UDSH2H1RS0R0GW1N UNIQUE(NOMBRE))
